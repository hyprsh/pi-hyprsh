{
	"name": "pi-hyprsh",
	"version": "0.1.0",
	"description": "Pi extension pack for this environment. Single-line footer, reason lines on built-in tools, context inspection views, and provider-neutral web search and fetch tools.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyprsh/pi-hyprsh.git"
	},
	"homepage": "https://github.com/hyprsh/pi-hyprsh#readme",
	"bugs": "https://github.com/hyprsh/pi-hyprsh/issues",
	"keywords": [
		"pi-package",
		"pi-extension",
		"footer",
		"web-search",
		"web-fetch"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "npm run lint && npm run typecheck"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.84.0",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"files": [
		"index.ts",
		"lib/",
		"skills/",
		"README.md"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@earendil-works/pi-ai": "^0.84.2",
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@earendil-works/pi-tui": "^0.84.2",
		"@types/node": "^26.2.0",
		"@types/turndown": "^5.0.6",
		"typebox": "^1.3.7",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"linkedom": "^0.18.13",
		"turndown": "^7.2.4",
		"unpdf": "^1.8.1"
	}
}
