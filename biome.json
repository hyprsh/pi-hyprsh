{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"files": {
		"includes": ["**/*.ts", "**/*.json", "!node_modules"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 110
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
